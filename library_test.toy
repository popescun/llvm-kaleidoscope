extern putch(x);

# for with multiple instructions and comment
def foo(x)
  for i = 1, i < x, 1.0  {
    putch(42); # first instruction
    putch(43);
#   putch(43);
  }

# nested for, multiple nested expressions
def foo1(x)
  for i = 1, i < x , 1.0 {
    for j = 1, j < x, 1.0  {
      putch(42);
    }
    putch(43);
  }

def foo2(x)
  if x < 3 {
    putch(43);
    putch(42);
  } else {
    putch(42);
    putch(43);
  }

# Binary logical or, which does not short circuit.
def binary| 5 (lhs, rhs)
  if lhs {
    1;
  } else {
    if rhs {
      1;
    } else {
      0;
    }
  }
